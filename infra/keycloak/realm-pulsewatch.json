{
  "realm": "pulsewatch",
  "enabled": true,
  "registrationAllowed": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "pulsewatch-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "pulsewatch"
      ]
    },
    {
      "clientId": "pulsewatch-cli",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "defaultClientScopes": [
        "pulsewatch"
      ]
    },
    {
      "clientId": "pulsewatch-api",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "clientScopes": [
    {
      "name": "pulsewatch",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-pulsewatch-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pulsewatch-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "org-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice@acme.test",
      "email": "alice@acme.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "org_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob@globex.test",
      "email": "bob@globex.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "org_id": [
          "22222222-2222-2222-2222-222222222222"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ]
    }
  ],
  "attributes": {
    "userProfileEnabled": "true"
  },
  "userProfile": {
    "attributes": [
      {
        "name": "org_id",
        "displayName": "Organization ID",
        "permissions": {
          "view": [
            "admin"
          ],
          "edit": [
            "admin"
          ]
        },
        "multivalued": false
      }
    ]
  }
}
